[Unit]
Description=Aquavar CPC pump dashboard (1 Hz sampler + web UI)
After=network.target

[Service]
Type=simple
User=pumpdash
Group=dialout
WorkingDirectory=/home/pmops/pump-test
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PUMP_DB=/dev/shm/pump.db
Environment=PUMP_HOST=0.0.0.0
Environment=PUMP_PORT=8080
ExecStart=/usr/bin/python3 -B /home/pmops/pump-test/pump_dashboard.py
Restart=always
RestartSec=5
LimitCORE=0

# /var/log/journal is persistent on this box, so keep logs in tmpfs instead of
# journald. Read failures are also recorded in the database and surfaced by
# /api/latest.
StandardOutput=append:/dev/shm/pump-dashboard.log
StandardError=append:/dev/shm/pump-dashboard.log

# Anything that ignores PRAGMA temp_store=MEMORY still gets a RAM-backed /tmp,
# and the app can only write to tmpfs.
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/dev/shm
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
